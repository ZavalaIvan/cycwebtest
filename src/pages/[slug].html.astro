---
import { getCollection } from "astro:content";
import "../styles/blog-shell.css";
import { loadLegacyBlogSource } from "../lib/legacy-blog";
import SeoHead from "../components/SeoHead.astro";
import GoogleTagManagerNoScript from "../components/GoogleTagManagerNoScript.astro";
import { absoluteUrl, blogImageBySlug, buildBreadcrumbSchema } from "../lib/seo";

export async function getStaticPaths() {
  const articles = await getCollection("blog");

  return articles.map((article) => ({
    params: { slug: article.data.canonicalSlug },
    props: { article }
  }));
}

const { article } = Astro.props;
const source = loadLegacyBlogSource(article.data);
const canonicalPath = `/blog/${article.data.canonicalSlug}/`;
const legacyPath = `/${article.data.canonicalSlug}.html`;
const articleImage = blogImageBySlug[article.data.canonicalSlug] ?? "/lago-tratado-con-blue-drop.jpg";
const structuredData = [
  {
    "@type": "BlogPosting",
    "@id": `${absoluteUrl(canonicalPath)}#article`,
    headline: article.data.title,
    description: article.data.description,
    image: absoluteUrl(articleImage),
    url: absoluteUrl(canonicalPath),
    mainEntityOfPage: absoluteUrl(canonicalPath),
    author: {
      "@id": "https://cycdelsureste.com/#organization"
    },
    publisher: {
      "@id": "https://cycdelsureste.com/#organization"
    },
    dateModified: "2026-06-30",
    inLanguage: "es-MX",
    articleSection: article.data.category
  },
  buildBreadcrumbSchema([
    { name: "Inicio", path: "/" },
    { name: "Blog", path: "/blog/" },
    { name: article.data.category, path: canonicalPath }
  ])
];
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title={article.data.title}
      description={article.data.description}
      path={legacyPath}
      canonicalPath={canonicalPath}
      image={articleImage}
      type="article"
      structuredData={structuredData}
    />
    <style is:global set:html={source.styles}></style>
  </head>
  <body class="blog-shell">
    <GoogleTagManagerNoScript />
    <header class="blog-topbar">
      <div class="blog-topbar__inner">
        <a class="blog-topbar__brand" href="/index.html" aria-label="CyC del Sureste">
          <img src="/cyc-logo.png" alt="CyC del Sureste" />
          <span class="blog-topbar__eyebrow">{article.data.eyebrow}</span>
        </a>

        <nav class="blog-topbar__nav" aria-label="Navegación principal del artículo">
          <a href="/index.html">Inicio</a>
          <a href="/blog/">Blog</a>
          <a href={canonicalPath}>Versión blog</a>
          <a href="/contacto.html">Contacto</a>
        </nav>
      </div>
    </header>

    <div class="blog-breadcrumbs blog-topbar__inner" aria-label="Breadcrumb">
      <a href="/index.html">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/blog/">Blog</a>
      <span aria-hidden="true">/</span>
      <span>Ruta legada</span>
    </div>

    <div class="blog-article-meta">
      <span class="blog-article-chip">URL anterior conservada</span>
      <span class="blog-article-chip">{article.data.readingTime} de lectura</span>
    </div>

    <main class={article.data.pageClass} set:html={source.content}></main>
  </body>
</html>
